:TypeArguments="x:String" ExpressionText="&quot;Sent&quot;" /></InArgument></Assign.Value></Assign></Sequence></TryCatch.Try><TryCatch.Catches><Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch`1_1"><ActivityAction x:TypeArguments="s:Exception"><ActivityAction.Argument><DelegateInArgument x:TypeArguments="s:Exception" Name="exception" /></ActivityAction.Argument><Sequence DisplayName="Catch"><Assign DisplayName="Set Notification Failed" sap2010:WorkflowViewState.IdRef="Assign_1"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="out_notificationStatus" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="&quot;Failed&quot;" /></InArgument></Assign.Value></Assign><Assign DisplayName="Capture Notification Error" sap2010:WorkflowViewState.IdRef="Assign_2"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="out_notificationError" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionText="exception.ToString()" /></InArgument></Assign.Value></Assign></Sequence></ActivityAction></Catch></TryCatch.Catches></TryCatch></Sequence></If.Then></If>
  <ui:InvokeCode DisplayName="Update Notification Columns" Language="VBNet" sap2010:WorkflowViewState.IdRef="InvokeCode_2" Code="If in_row IsNot Nothing Then&#xA;    If in_row.Table.Columns.Contains(&quot;NotificationStatus&quot;) Then in_row(&quot;NotificationStatus&quot;) = out_notificationStatus&#xA;    If in_row.Table.Columns.Contains(&quot;NotificationError&quot;) Then in_row(&quot;NotificationError&quot;) = out_notificationError&#xA;End If"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="sd:DataRow" x:Key="in_row">[in_row]</InArgument><InArgument x:TypeArguments="x:String" x:Key="out_notificationStatus">[out_notificationStatus]</InArgument><InArgument x:TypeArguments="x:String" x:Key="out_notificationError">[out_notificationError]</InArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode>
